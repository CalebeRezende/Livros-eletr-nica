# Copie este arquivo para ".env" e ajuste as senhas antes de subir o Moodle.
# Nunca faça commit do arquivo ".env" real (ele já está no .gitignore).

# Banco de dados (MariaDB)
MARIADB_ROOT_PASSWORD=troque_esta_senha_root
MOODLE_DATABASE_PASSWORD=troque_esta_senha_db

# Portas expostas na sua máquina
MOODLE_HTTP_PORT=8080
MOODLE_HTTPS_PORT=8443

# Usuário administrador do Moodle
MOODLE_USERNAME=admin
MOODLE_PASSWORD=troque_esta_senha_admin
MOODLE_EMAIL=seu-email@exemplo.com

# Configurações do site
MOODLE_SITE_NAME=Meu Moodle
MOODLE_LANG=pt_br
